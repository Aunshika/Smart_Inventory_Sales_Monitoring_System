# Development Docker environment
MONGODB_URI=mongodb://database:27017/Smartinventory
DATABASE_NAME=Smartinventory
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PUBLIC_BACKEND_URL=http://localhost:8080

JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ADMIN_TOKEN_EXPIRE_MINUTES=15

GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE
RECAPTCHA_SITE_KEY=your_public_site_key
RECAPTCHA_SECRET_KEY=your_private_secret_key
RECAPTCHA_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

ADMIN_INITIAL_USERNAME=aunshika
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=choose_a_local_development_password
SEED_USER_INITIAL_PASSWORD=Smart@1234

LOG_LEVEL=INFO
LOG_DIR=logs
RUN_STARTUP_MAINTENANCE=0
